{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    // The renderer is a sandboxed browser context: DOM types, JSX, and `vite/client` for the stylesheet import.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
