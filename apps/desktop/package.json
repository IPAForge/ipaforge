{
  "name": "@ipaforge/desktop",
  "version": "0.1.0-alpha.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "pnpm run ensure-electron && electron-vite dev",
    "build": "electron-vite build",
    "preview": "pnpm run ensure-electron && electron-vite preview",
    "ensure-electron": "node -e \"require('electron')\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/renderer/tsconfig.json",
    "device-probe": "tsx scripts/device-probe.ts",
    "apple-probe": "tsx scripts/apple-probe.ts",
    "catalog-probe": "tsx scripts/catalog-probe.ts",
    "install-probe": "tsx scripts/install-probe.ts",
    "dist": "electron-vite build && electron-builder --publish never"
  },
  "devDependencies": {
    "@ipaforge/apple": "workspace:*",
    "@ipaforge/catalog": "workspace:*",
    "@ipaforge/device": "workspace:*",
    "@ipaforge/installer": "workspace:*",
    "@ipaforge/kernel": "workspace:*",
    "@ipaforge/rpc": "workspace:*",
    "@ipaforge/signer": "workspace:*",
    "@ipaforge/ui": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router": "1.170.44",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0-beta.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.4"
  },
  "productName": "IPAForge",
  "description": "Install SideStore and preload your apps onto iPhone and iPad.",
  "author": "Dan Motpan",
  "homepage": "https://github.com/SirReaDy/ipaforge"
}
