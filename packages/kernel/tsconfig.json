{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Isomorphic baseline: globals shared by Node 22 and browsers/workers, no Node or DOM-only types.
    "lib": ["ES2023", "WebWorker"],
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/__tests__/**"]
}
