{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The UI runs in a browser renderer: DOM types instead of the platform-free WebWorker baseline.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // Built with Vite: `vite/client` types the stylesheet import and `import.meta.env` in main.tsx.
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/__tests__/**"]
}
