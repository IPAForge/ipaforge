{
  // The editor's project: source and tests together, so every file VS Code opens resolves the @… aliases.
  // tsconfig.src.json checks the source alone, without test-only types.
  "extends": "./tsconfig.src.json",
  "compilerOptions": {
    // Tests run in Vitest with happy-dom.
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": []
}
