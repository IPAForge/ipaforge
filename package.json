{
  "name": "ipaforge",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "vitest run",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json",
    "lint": "biome check . && eslint packages apps scripts tooling",
    "format": "biome format --write . && eslint --fix packages apps scripts tooling",
    "check:boundaries": "node scripts/check-boundaries.ts",
    "check:locales": "node scripts/check-locales.ts",
    "test:coverage": "vitest run --coverage",
    "prepare": "git config core.hooksPath .githooks || true",
    "lint:fix": "biome check --write . && eslint --fix packages apps scripts tooling",
    "verify": "pnpm lint && pnpm typecheck && pnpm check:boundaries && pnpm check:locales && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@formatjs/icu-messageformat-parser": "3.5.18",
    "@ipaforge/tooling-eslint": "workspace:*",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "10.11.0",
    "tsx": "4.23.15",
    "turbo": "2.11.7",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "license": "MIT"
}
