{
  "name": "loadstar",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "vitest run",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check:boundaries": "node scripts/check-boundaries.ts",
    "test:coverage": "vitest run --coverage",
    "prepare": "git config core.hooksPath .githooks || true",
    "lint:fix": "biome check --write .",
    "verify": "pnpm lint && pnpm typecheck && pnpm check:boundaries && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.4",
    "tsx": "4.23.15",
    "turbo": "2.11.7",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "license": "MIT"
}
