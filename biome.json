{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/coverage",
      "!fixtures/**/inputs",
      "!fixtures/**/expected",
      "!scripts/__fixtures__",
      "!tooling/biome/__fixtures__",
      "!fixtures/**/manifest.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "none",
      "lineWidth": 80
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "warn"
      },
      "suspicious": {
        "noConsole": "warn"
      },
      "style": {
        "useImportType": "error",
        "useNodejsImportProtocol": "error",
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "type"
          }
        }
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":NODE:", ":BUN:"],
              ":BLANK_LINE:",
              [
                ":PACKAGE:",
                "!@loadstar/**",
                "!@kernel/**",
                "!@signer/**",
                "!@device/**",
                "!@apple/**",
                "!@catalog/**",
                "!@installer/**",
                "!@rpc/**",
                "!@ui/**",
                "!@desktop/**"
              ],
              ":BLANK_LINE:",
              [
                "@loadstar/**",
                "@kernel/**",
                "@signer/**",
                "@device/**",
                "@apple/**",
                "@catalog/**",
                "@installer/**",
                "@rpc/**",
                "@ui/**",
                "@desktop/**"
              ],
              ":BLANK_LINE:",
              ":PATH:"
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/*/src/**",
        "!packages/**/*.test.ts",
        "!packages/**/*.test.tsx",
        "!packages/**/__tests__/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "electron": "packages/* must stay platform-free; put Electron code in apps/desktop.",
                  "fs": "packages/* must stay platform-free; use the FileSource port.",
                  "path": "packages/* must stay platform-free.",
                  "net": "packages/* must stay platform-free; use the DeviceTransport port.",
                  "tls": "packages/* must stay platform-free; use the TlsUpgrader port.",
                  "buffer": "Use Uint8Array, not Buffer."
                },
                "patterns": [
                  {
                    "group": ["node:*"],
                    "message": "packages/* must stay platform-free; Node built-ins belong in apps/* adapters."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/ui/**"],
      "linter": {
        "domains": {
          "react": "all"
        },
        "rules": {
          "a11y": "error"
        }
      }
    },
    {
      "includes": ["packages/ui/src/**/*.tsx"],
      "plugins": ["./tooling/biome/no-jsx-literal-text.grit"]
    },
    {
      "includes": [
        "scripts/**",
        "packages/*/scripts/**",
        "apps/desktop/scripts/**",
        "apps/desktop/src/probes/**",
        "packages/ui/src/services/logging/console-log-sink.ts",
        "apps/desktop/src/main/logger.ts",
        "packages/kernel/src/logging/create-logger.ts",
        "**/*.test.ts",
        "**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ],
  "plugins": ["./tooling/biome/no-function-declaration.grit"]
}
